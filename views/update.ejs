<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Update Course Review</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    </head>
<body>
    <%- include("partials/flash.ejs") %>
    <%- include("partials/navbar.ejs") %>

    <div class="update-container">
        <h1>Update Review</h1>
        
        <form action="/update/<%= review._id %>" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <p>Course: <%= review.department %> <%= review.course_num %></p>
            </div>

            <div class="form-group">
                <label>Average hours per Week: <span id="hoursValue">10</span></label>
                <input type="range" id="hours-per-week" name="hours-per-week" min="0" max="30" value="<%= review.hours %>" step="1">
            </div>

            <div class="form-group">
                <label>Difficulty: <span id="difficultyValue">3</span></label>
                <input type="range" id="difficulty" name="difficulty" min="1" max="5" value="<%= review.difficulty %>" step="0.5">
            </div>

            <div class="form-group">
                <label for="take-again">Would take this class again?</label>
                <input type="radio" id="yes" name="yes-no" value="yes" <%= review.retake ? 'checked' : '' %>>
                <label for="yes">Yes</label><br>
                <input type="radio" id="no" name="yes-no" value="no" <%= !review.retake ? 'checked' : '' %>>
                <label for="no">No</label><br>
            </div>

            <div class="form-group">
                <label for="tags">Tags</label>
                <select name="tag" multiple size="1">
                    <option value="easyA" <%= review.tags && review.tags.includes("easyA") ? "selected" : "" %>>Easy A</option>
                    <option value="discussion" <%= review.tags && review.tags.includes("discussion") ? "selected" : "" %>>Discussion-based</option>
                    <option value="flipped" <%= review.tags && review.tags.includes("flipped") ? "selected" : "" %>>Flipped classroom</option>
                    <option value="300" <%= review.tags && review.tags.includes("300") ? "selected" : "" %>>300-level</option>
                    <option value="reading" <%= review.tags && review.tags.includes("reading") ? "selected" : "" %>>Reading heavy</option>
                    <option value="tests" <%= review.tags && review.tags.includes("tests") ? "selected" : "" %>>No tests</option>
                </select>
            </div>

            <div class="form-group">
                <label for="comments">Comments</label>
                <textarea id="comments" name="comments" class="form-control" rows="4" 
                    placeholder="Write your comments here..." required><%= review.comments %></textarea>
            </div>

            <div class="file-upload">
                <p>
                    <label>Syllabus Upload
                        <input type="file" accept="application/pdf" name="syllabus" >
                    </label>
                </p>
            </div>
            <button type="submit">Update</button>
        </form>
        <br> 
        <form id="delete" method="POST" action="/delete/<%= review._id %>">
        <input type="submit" value="delete">
      </form>
    </div>

    <%- include("partials/bootstrap.ejs") %>
</body>
</html>