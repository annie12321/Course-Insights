<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Update Course Review</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/styles.css">
</head>

<body>
<%- include("partials/navbar.ejs") %>
<%- include("partials/flash.ejs") %>

<div class="container d-flex justify-content-center">

    <div class="card shadow-sm upload-card">
        <div class="card-body">

            <h1 class="card-title mb-3">Update Review</h1>

            <p class="text-muted mb-4">
                <b>Course:</b> <%= review.department %> <%= review.course_num %>
            </p>

            <form action="/update/<%= review._id %>"
                  method="POST"
                  enctype="multipart/form-data">

                <div class="form-group">
                    <label for="hours-per-week">
                        Average hours/week:
                        <b id="hoursValue"><%= review.hours %></b>
                    </label>

                    <input type="range"
                           class="custom-range"
                           id="hours-per-week"
                           name="hours-per-week"
                           min="0" max="30"
                           value="<%= review.hours %>"
                           step="1">
                </div>

                <div class="form-group">
                    <label for="difficulty">
                        Difficulty:
                        <b id="difficultyValue"><%= review.difficulty %></b>
                    </label>

                    <input type="range"
                           class="custom-range"
                           id="difficulty"
                           name="difficulty"
                           min="1" max="5"
                           value="<%= review.difficulty %>"
                           step="0.1">
                </div>

                <div class="form-group">
                    <fieldset>
                        <legend><b>Would take again?</b></legend>

                        <div class="mr-3">
                            <input type="radio"
                                   id="retake-yes"
                                   name="yes-no"
                                   value="yes"
                                   <%= review.retake ? "checked" : "" %>>
                            <label for="retake-yes">Yes</label>
                        </div>

                        <div>
                            <input type="radio"
                                   id="retake-no"
                                   name="yes-no"
                                   value="no"
                                   <%= !review.retake ? "checked" : "" %>>
                            <label for="retake-no">No</label>
                        </div>
                    </fieldset>
                </div>

                <div class="form-group">
                    <label for="tags"><b>Tags</b></label>

                    <select name="tag"
                            id="tags"
                            multiple
                            size="1"
                            class="form-control">

                        <option value="easyA"
                            <%= review.tags?.includes("easyA") ? "selected" : "" %>>
                            Easy A
                        </option>
                        <option value="discussion"
                            <%= review.tags?.includes("discussion") ? "selected" : "" %>>
                            Discussion-based
                        </option>
                        <option value="flipped"
                            <%= review.tags?.includes("flipped") ? "selected" : "" %>>
                            Flipped classroom
                        </option>
                        <option value="300"
                            <%= review.tags?.includes("300") ? "selected" : "" %>>
                            300-level
                        </option>
                        <option value="reading"
                            <%= review.tags?.includes("reading") ? "selected" : "" %>>
                            Reading heavy
                        </option>
                        <option value="tests"
                            <%= review.tags?.includes("tests") ? "selected" : "" %>>
                            No tests
                        </option>

                    </select>
                </div>

                <div class="form-group">
                    <label for="comments"><b>Comments</b></label>

                    <textarea id="comments"
                              name="comments"
                              class="form-control"
                              rows="4"
                              required><%= review.comments %></textarea>
                </div>

                <div class="form-group">
                    <label for="syllabus"><b>Syllabus (optional)</b></label>

                    <input id="syllabus"
                           type="file"
                           class="form-control-file"
                           accept="application/pdf"
                           name="syllabus">
                </div>

                <button type="submit"
                        class="btn btn-primary btn-block mt-3">
                    Update Review
                </button>

            </form>

            <form id="delete"
                  method="POST"
                  action="/delete/<%= review._id %>"
                  class="mt-3">

                <button type="submit"
                        class="btn btn-outline-danger btn-block">
                    Delete Review
                </button>
            </form>

        </div>
    </div>

</div>

<%- include("partials/bootstrap.ejs") %>
</body>
</html>