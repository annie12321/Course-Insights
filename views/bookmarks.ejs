<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Bookmarks</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <%- include("partials/navbar.ejs") %>
    <%- include("partials/flash.ejs") %>

    <div class="bookmarks-wrapper container">

        <h1 class="card-title mb-4">Bookmarked Courses</h1>

        <div id="bookmarked-classes-container" class="mt-3">

            <% if (results.length === 0) { %>
                <p class="text-center text-muted">
                    No bookmarked courses yet.
                </p>

            <% } else { %>
                <div class="row">
                    <% results.forEach((result) => { %>
                        <div class="col-12 mb-3">
                            <div class="card course-card shadow-sm position-relative">
                                <div class="card-body">
                                    <h2 class="card-title mb-1">
                                        <%= result.department %> <%= result.course_num %>
                                    </h2>
                                    <h3 class="card-subtitle mb-2">
                                        <%= result.title %>
                                    </h3>
                                    <p class="card-text small mt-2 mb-0">
                                        <b>Instructor(s):</b>
                                        <%= result.instructors.join("; ") %>
                                    </p>
                                    <a href="/course/<%= result.department %>/<%= result.course_num %>"
                                       class="stretched-link"
                                       aria-label="View details for <%= result.department %> <%= result.course_num %>">
                                    </a>

                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <%- include("partials/bootstrap.ejs") %>
</body>
</html>