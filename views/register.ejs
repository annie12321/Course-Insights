<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Register</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- loading Pixelfy Sans font -->
    <link href='https://fonts.googleapis.com/css?family=Pixelify+Sans' rel='stylesheet'>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="auth-container container-fluid vh-100">
        <%- include("partials/flash.ejs") %>
        <div class="row h-100 g-0">
            <%- include("partials/splash.ejs") %>
            <div class="col-sm-6 text-black d-flex align-items-center justify-content-center">
                <div class="px-5 w-100">
                    <h1 id="register">Create an Account</h1>
                    <form action="/register" method="POST" class="register-form">
                        <div class="form-group mb-1">
                            <label for="username">Username</label>
                            <input type="text" id="username" name="username" placeholder="Username" required>
                        </div>

                        <div class="form-group mb-1">
                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="addr" placeholder="e.g. student@wellesley.edu" required>
                        </div>

                        <div class="form-group mb-1">
                            <label for="class-year">Class Year</label>
                            <select name="year" id="class-year" required>
                                <option value="" disabled selected hidden>Select one</option>
                                <option value="2026">2026</option>
                                <option value="2027">2027</option>
                                <option value="2028">2028</option>
                                <option value="2029">2029</option>
                            </select>
                        </div>

                        <div class="form-group mb-1">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="Create a password" required>
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm password" required>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary btn-lg">Create Account</button>
                        </div>
                    </form>
                    
                    <p class="text-muted">Already have an account? <a class="link" href="/login"><u>Login here</u></a>.</p>
                </div>
            </div>
        </div>
    </main>
    <%- include("partials/bootstrap.ejs") %>
</body>
</html>