<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Course View</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
<%- include("partials/navbar.ejs") %>
<%- include("partials/flash.ejs") %>

<%
const tagMap = {
    easyA: { label: "Easy A", class: "badge-success" },
    discussion: { label: "Discussion-based", class: "badge-info" },
    flipped: { label: "Flipped classroom", class: "badge-primary" },
    "300": { label: "300-level", class: "badge-warning" },
    reading: { label: "Reading heavy", class: "badge-dark" },
    tests: { label: "No tests", class: "badge-secondary" }
};

const reverseTagMap = {
    "Easy A": "easyA",
    "Discussion-based": "discussion",
    "Flipped classroom": "flipped",
    "300-level": "300",
    "Reading heavy": "reading",
    "No tests": "tests"
};

function getColor(username) {
    const colors = [
        "#6c5b7b", "#c06c84", "#f67280",
        "#355c7d", "#99b898", "#ff847c"
    ];
    if (!username) return "#6c5b7b";

    let hash = 0;
    for (let i = 0; i < username.length; i++) {
        hash = username.charCodeAt(i) + ((hash << 5) - hash);
    }
    return colors[Math.abs(hash) % colors.length];
}
%>

<div id="course-container" class="container">
    <div class="row position-relative">

        <div class="col-md-6">
            <div class="card course-card shadow-sm mb-4">
                <div class="card-body">

                    <h1 class="card-title mb-2">
                        <%= course.department %> <%= course.course_num %>
                    </h1>

                    <p class="card-subtitle mb-3 text-muted">
                        <b><%= course.title %></b>
                    </p>

                    <button id="save-button" class="mb-3 btn btn-light" aria-label="<%= saved ? 'Remove from bookmarks' : 'Add to bookmarks' %>">
                        <i class="<%= saved ? 'fa-solid' : 'fa-regular' %> fa-bookmark"
                        data-course="<%= course.department %> <%= course.course_num %>"></i>
                    </button>

                    <p class="card-text mb-1">
                        <b>Instructor(s):</b> <%= course.instructors.join("; ") %>
                    </p>
                    <p class="card-text mb-1">
                        <b>Avg Hours:</b> <%= course.avgHours %> |
                        <b>Avg Difficulty:</b> <%= course.avgDifficulty %>
                    </p>
                    <p class="card-text mb-2">
                        <b>Retake Rate:</b>
                        <%= (course.retake != null) ? course.retake + "%" : "N/A" %>
                    </p>
                    <p class="card-text small mb-2">
                        <b>Tags:</b>
                        <% if (course.tags && course.tags.length > 0) { %>
                            <% course.tags.forEach(tag => { %>
                                <% const t = tagMap[reverseTagMap[tag]]; %>
                                <% if (t) { %>
                                    <span class="badge badge-pill <%= t.class %> mr-1">
                                        <%= t.label %>
                                    </span>
                                <% } %>
                            <% }) %>
                        <% } else { %>
                            <span class="text-muted small">No tags</span>
                        <% } %>
                    </p>
                     <% if (reviewID) { %>
                        <a href="/update/<%=reviewID._id.toString()%>"
                        class="btn btn-primary btn-sm mt-2">
                            Update Review
                        </a>
                    <% } else {%>
                        <a href="/upload/<%= course.department %>/<%= course.course_num %>"
                        class="btn btn-primary btn-sm mt-2">
                            Upload Review
                        </a>
                    <% } %>
                </div>
            </div>
            <% if (file != null && fileSaved) { %>
            <div class="card course-card shadow-sm mb-4">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h2 class="card-title">Syllabus</h2>
                        <iframe class="uploadedSyllabus" src="<%= file.path %>"></iframe>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

        <div class="vertical-divider"></div>

        <div class="col-md-6 d-flex flex-column">

            <h2  class="mb-3 student-reviews">Student Reviews</h2>

            <div class="reviews-scroll">
                <% if (reviews.length === 0) { %>
                    <p class="text-muted">No reviews yet. Be the first!</p>
                <% } else { %>
                    <% reviews.forEach(function(r) { %>
                        <div class="card course-card shadow-sm mb-3">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="profile-avatar small-avatar mr-2">
                                        <%= r.username.charAt(0).toUpperCase() %>
                                    </div>
                                    <b><%= r.username || "Anonymous" %></b>
                                    <span class="text-muted small ml-2">
                                        • <%= r.submittedAt ? new Date(r.submittedAt).toLocaleDateString() : "Recently" %>
                                    </span>
                                </div>
                                <p class="card-text small mb-1">
                                    <b>Hours per Week:</b> <%= r.hours %> |
                                    <b>Difficulty:</b> <%= r.difficulty %>
                                </p>
                                <p class="card-text small mb-1">
                                    <b>Would take again:</b> <%= r.retake ? "Yes" : "No" %>
                                </p>
                                <p class="card-text small tag-size mb-2">
                                    <b>Tags:</b>
                                    <% if (r.tags.length > 0) { %>
                                        <% r.tags.forEach(tag => { %>
                                            <% const t = tagMap[tag]; %>
                                            <% if (t) { %>
                                                <span class="badge badge-pill <%= t.class %> mr-1">
                                                    <%= t.label %>
                                                </span>
                                            <% } %>
                                        <% }) %>
                                    <% } else { %>
                                        <span class="text-muted small">No tags</span>
                                    <% } %>
                                </p>
                                <p class="card-text small mb-2">
                                    <b>Comments:</b> <%= r.comments %>
                                </p>
                                <% if (user.role === "admin") { %>
                                    <a href="/update/<%= r._id %>" class="btn btn-primary btn-sm">
                                        Update Review
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>

                <% } %>

            </div>
        </div>

    </div>
</div>

<%- include("partials/bootstrap.ejs") %>
</body>
</html>