<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Course View</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css">
    </head>
<body>
    <%- include("partials/navbar.ejs") %>

    <div id="course-container">
        <h1><%= course.department %><%= course.course_num %>: <%= course.title %></h1>
        
        <p><b>Instructor(s):</b> <%= course.instructors.join("; ") %></p>
        <!-- <p><b>Distribution(s):</b> <%= course.distributions %></p> -->
        <p><b>Average hours spent:</b> <%= course.avgHours %></p>
        <p><b>Average Difficulty:</b> <%= course.avgDifficulty %></p>
        <p><b>Percent that would retake:</b> 
            <%= (course.retake !== undefined && course.retake !== null)
                ? course.retake + "%"
                : "" %>
        </p>
        <p><b>Tags:</b> <%= course.tags ? course.tags.join(", ") : "" %></p>
        <!-- might need special formatting for the list ones (dists, tags) -->
        <% if( file != null ) { %>
            <iframe class="uploadedSyllabus" src="<%= file.path %>" title="<%= file.title %>">
            </iframe>
        <% } %>
    </div>

    <button id="save-button">
        <i class="fa-regular fa-bookmark" data-course="<%= course.department %> <%= course.course_num %>"></i>
    </button>

    <div>
       <p> <a href="/upload/<%= course.department %>/<%= course.course_num %>" class="btn btn-primary">Upload Review</a></p>
    </div>

    <div id="reviews-container">
        <h2>Student Reviews</h2>

        <% if (reviews.length === 0) { %>
            <p>No reviews yet. Be the first!</p>
        <% } %>

        <% reviews.forEach(function(r) { %>
            <div class="review-card">
                 <% if (user.role === "admin") { %>
                    <p>
                        <a href="/update/<%= r._id %>" class="btn btn-primary">Update Review</a>
                    </p>
                <% } %>
                <p>
                    <b>User:</b> <%= r.username %>
                    <span class="text-muted small">
                        • <%= r.submittedAt ? new Date(r.submittedAt).toLocaleDateString() : "Recently" %>
                    </span>
                </p>
                <p><b>Hours/week:</b> <%= r.hours %></p>
                <p><b>Difficulty:</b> <%= r.difficulty %></p>
                <p><b>Would take again:</b> <%= r.retake ? "Yes" : "No" %></p>
                <p><b>Tags:</b> <%= r.tags.join(", ") %></p>
                <p><b>Comments:</b> <%= r.comments %></p>
                <hr>
            </div>
        <% }) %>
    </div>
    
    <%- include("partials/bootstrap.ejs") %>
</body>
</html>