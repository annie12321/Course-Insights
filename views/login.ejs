<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Login</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- loading Pixelfy Sans font -->
    <link href='https://fonts.googleapis.com/css?family=Pixelify Sans' rel='stylesheet'>
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="login-container container-fluid vh-100">
        <%- include("partials/flash.ejs") %>
        <div class="row h-100 g-0">
            <section class="col-sm-6 d-none d-sm-flex flex-column align-items-center justify-content-center border-end">
                <div class="text-center">
                    <img src="logo.jpg" alt="logo of hamster reading book" class="img-fluid logo">
                    <h1 class="fw-bold logo-title">Course Insights</h1>
                </div>
            </section>
            <div class="vertical-divider"></div>
             <section class="col-sm-6 text-black d-flex align-items-center justify-content-center">
                <div class="px-5 w-100">
                    <h1 id="login">Login</h1>
                    <form action="/login" method="POST">
                        <div class="form-group  mb-1">
                            <label for="username">Username</label>
                            <input type="text" id="username" name="username" placeholder="Enter username" required>
                        </div>

                        <div class="form-group">
                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="Enter password" required>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary btn-lg">Login</button>
                        </div>
                    </form>
                    
                    <p class="text-muted"></p>Don't have an account? <a class="link" href="/register"><u>Register here</u></a>.</p>
                </div>
            </section>
        </div>
    </main> 
    <%- include("partials/bootstrap.ejs") %>
</body>
</html>