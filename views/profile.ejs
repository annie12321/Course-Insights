<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Course Insights: Profile</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <%- include("partials/navbar.ejs") %>

    <div id="profile-container">
        <h1><%= user.username %>'s Profile</h1>
        <p><b>Role:</b> <%= user.role %></p>
        <p><b>Email:</b> <%= user.email %></p>
        <p><b>Class Year:</b> <%= user.class_year %></p>
        <p><b>Reviews:</b></p>
        <% if (reviews && reviews.length > 0) { %>
            <ul class = "reviews">
                <% reviews.forEach(function(r) { %>
                    <li class="review-card">
                        <p>
                            <a href="/update/<%= r._id %>" class="btn btn-primary">Update Review</a>
                        </p>
                        <p>
                            <b>Course:</b> 
                            <a href="/course/<%= r.department %>/<%= r.course_num %>">
                                <%= r.department %> <%= r.course_num %>
                            </a>
                        </p>
                        <p><b>Hours/week:</b> <%= r.hours %></p>
                        <p><b>Difficulty:</b> <%= r.difficulty %></p>
                        <p><b>Would take again:</b> <%= r.retake ? "Yes" : "No" %></p>
                        <p><b>Tags:</b> <%= r.tags.join(", ") %></p>
                        <p><b>Comments:</b> <%= r.comments %></p>
                        <p><small><%= r.submittedAt ? new Date(r.submittedAt).toLocaleDateString() : "" %></small></p>
                        <hr>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </div>

    <%- include("partials/bootstrap.ejs") %>
</body>
</html>
