<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Profile</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include("partials/navbar.ejs") %>

    <%
    const tagMap = {
        easyA: { label: "Easy A", class: "badge-success" },
        discussion: { label: "Discussion-based", class: "badge-info" },
        flipped: { label: "Flipped classroom", class: "badge-primary" },
        "300": { label: "300-level", class: "badge-warning" },
        reading: { label: "Reading heavy", class: "badge-dark" },
        tests: { label: "No tests", class: "badge-secondary" }
    };
    %>

    <div id="profile-container" class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="profile-avatar mr-3">
                                <%= user.username.charAt(0).toUpperCase() %>
                            </div>
                            <h3 class="card-title mb-0">
                                <%= user.username %>'s Profile
                            </h3>
                        </div>
                        <p class="card-text mb-1">
                            <b>Role:</b> <%= user.role %>
                        </p>
                        <p class="card-text mb-1">
                            <b>Email:</b> <%= user.email %>
                        </p>
                        <p class="card-text mb-0">
                            <b>Class Year:</b> <%= user.class_year %>
                        </p>
                    </div>
                </div>
            </div>

            <div class="vertical-divider"></div>

            <div class="col-md-6">
                <h4 class="mb-3">Your Reviews</h4>
                <% if (reviews && reviews.length > 0) { %>
                    <% reviews.forEach(function(r) { %>
                        <div class="card course-card shadow-sm mb-3">
                            <div class="card-body">
                                <h5 class="card-title mb-1">
                                    <%= r.department %> <%= r.course_num %>
                                </h5>
                                <p class="card-text small mb-1">
                                    <b>Hours:</b> <%= r.hours %> |
                                    <b>Difficulty:</b> <%= r.difficulty %>
                                </p>
                                <p class="card-text small mb-1">
                                    <b>Would take again:</b> <%= r.retake ? "Yes" : "No" %>
                                </p>
                                <p class="card-text small mb-2">
                                    <b>Tags:</b>
                                    <% if (r.tags.length > 0) { %>
                                        <% r.tags.forEach(tag => { %>
                                            <% const t = tagMap[tag]; %>
                                            <% if (t) { %>
                                                <span class="badge badge-pill <%= t.class %> mr-1">
                                                    <%= t.label %>
                                                </span>
                                            <% } %>
                                        <% }) %>
                                    <% } else { %>
                                        <span class="text-muted small">No tags</span>
                                    <% } %>
                                </p>
                                <p class="card-text small mb-2">
                                    <b>Comments:</b> <%= r.comments %>
                                </p>
                                <a href="/update/<%= r._id %>" class="btn btn-primary btn-sm">
                                    Update Review
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="text-muted">No reviews yet.</p>
                <% } %>
            </div>
        </div>
    </div>
    <%- include("partials/bootstrap.ejs") %>
</body>
</html>