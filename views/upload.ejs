<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Upload Course Review</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    </head>
<body>
    <%- include("partials/navbar.ejs") %>

    <div class="login-container">
        <h1>Upload Review</h1>
        
        <form action="/upload" method="POST">
            <div class="form-group">
                <label for="course">Course</label>
                <select name="course" id="course" class="form-control" required>
                    <option value="">Choose a course...</option>
                    <% courses.forEach(function(c) { %>
                        <option value="<%= c.department %>-<%= c.course_num %>">
                            <%= c.department %> <%= c.course_num %>: <%= c.title %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label>Average hours per Week: <span id="hoursValue">10</span></label>
                <input type="range" id="hours-per-week" name="hours-per-week" min="0" max="30" value="10" step="1">
            </div>
            <!-- TODO: make hours-per-week into hoursPerWeek everywhere -->

            <div class="form-group">
                <label>Difficulty: <span id="difficultyValue">3</span></label>
                <input type="range" id="difficulty" name="difficulty" min="1" max="5" value="3" step="0.5">
            </div>

            <div class="form-group">
                <label for="take-again">Would take this class again?</label>
                <input type="radio" id="yes" name="yes-no" value="yes">
                <label for="yes">Yes</label><br>
                <input type="radio" id="no" name="yes-no" value="no" checked>
                <label for="no">No</label><br>
            </div>

            <div class="form-group">
                <label for="tags">Tags</label>
                <select name="tag" multiple size="1">
                    <option value="easyA">Easy A</option>
                    <option value="discussion">Discussion-based</option>
                    <option value="flipped">Flipped classroom</option>
                    <option value="300">300-level</option>
                    <option value="reading">Reading heavy</option>
                    <option value="tests">No tests</option>
                </select>
            </div>

            <div class="form-group">
                <label for="comments">Comments</label>
                <input type="text" id="comments" name="comments" placeholder="Review" required>
            </div>

            <button type="submit" class="btn">Review</button>
        </form>
    </div>
    <!-- load Bootstrap js -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.7/dist/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
    <!-- load local js -->
    <script src="/main.js"></script>
</body>
</html>