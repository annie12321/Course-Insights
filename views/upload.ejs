<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Upload Course Review</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- load local stylesheet (css) -->
    <link rel="stylesheet" href="/styles.css" />
    </head>
<body>
    <%- include("partials/navbar.ejs") %>

    <div class="upload-container">
        <h1>Upload Review</h1>
        
        <form action="/upload/<%= course.department%>/<%= course.course_num %>" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <p>Course: <%= course.searchTerm %></p>
            </div>

            <div class="form-group">
                <label for="hours-per-week">
                    Average hours per week: <span id="hoursValue">10</span>
                </label>
                <input type="range" id="hours-per-week" name="hoursPerWeek" min="0" max="30" value="10" step="1">
            </div>

            <div class="form-group">
                <label for="difficulty">
                    Difficulty: <span id="difficultyValue">3</span>
                </label>
                <input type="range" id="difficulty" name="difficulty" min="1" max="5" value="3" step="0.1">
            </div>

            <div class="form-group">
                <label>Would take this class again?</label><br>
                <input type="radio" id="retake-yes" name="yes-no" value="yes">
                <label for="retake-yes">Yes</label><br>
                <input type="radio" id="retake-no" name="yes-no" value="no" checked>
                <label for="retake-no">No</label><br>
            </div>

            <div class="form-group">
                <label for="tags">Tags</label>
                <select name="tags" id="tags" multiple size="1">
                    <option value="easyA">Easy A</option>
                    <option value="discussion">Discussion-based</option>
                    <option value="flipped">Flipped classroom</option>
                    <option value="300">300-level</option>
                    <option value="reading">Reading heavy</option>
                    <option value="tests">No tests</option>
                </select>
            </div>

            <div class="form-group">
                <label for="comments">Comments</label>
                <textarea id="comments" name="comments" class="form-control" rows="4" 
                    placeholder="Write your comments here..." required></textarea>
            </div>

            <div class="file-upload">
                <p>
                    <label>Syllabus Upload
                        <input type="file" accept="application/pdf" name="syllabus" >
                    </label>
                </p>
            </div>
            <button type="submit" class="btn btn-primary">Submit Review</button>
        </form>
    </div>

    <%- include("partials/bootstrap.ejs") %>
</body>
</html>