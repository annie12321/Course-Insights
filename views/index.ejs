<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">

    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <%- include("partials/navbar.ejs") %>
    <%- include("partials/flash.ejs") %>

    <div class="container">

        <div class="row justify-content-center mb-3">
            <div class="col-sm-6 d-none d-sm-flex flex-column align-items-center justify-content-center border-end">
                <div class="text-center">
                    <img src="/logo.jpg"
                         alt="logo of hamster reading book"
                         class="img-fluid logo logo-index">
                </div>
            </div>
        </div>

        <div id="search-container">
            <form class="search" method="GET" action="/search/">
                <p>
                    <label>
                        Search:
                        <input type="text" name="term" placeholder="Search courses...">
                    </label>

                    <label for="tags">
                        Tags:
                        <select name="tag" id="tags" multiple size="1">
                            <option value="easyA">Easy A</option>
                            <option value="discussion">Discussion-based</option>
                            <option value="flipped">Flipped classroom</option>
                            <option value="300">300-level</option>
                            <option value="reading">Reading heavy</option>
                            <option value="tests">No tests</option>
                        </select>
                    </label>

                    <input type="submit" value="Search">
                </p>
            </form>
        </div>

        <div id="search-results-container" class="mt-5">
            <% if (results.length === 0) { %>
                <p class="text-center text-muted">
                    No courses found matching your criteria.
                </p>
            <% } else { %>
                <div class="row">
                    <% results.forEach((result) => { %>
                        <div class="col-12 mb-3">
                            <div class="card course-card shadow-sm position-relative">
                                <div class="card-body">
                                    <h2 class="card-title mb-1">
                                        <%= result.department %> <%= result.course_num %>
                                    </h2>
                                    <h3 class="card-subtitle mb-2">
                                        <%= result.title %>
                                    </h3>
                                    <p class="card-text small mt-2 mb-0">
                                        <b>Instructor(s):</b>
                                        <%= result.instructors.join("; ") %>
                                    </p>

                                    <a href="/course/<%= result.department %>/<%= result.course_num %>"
                                       class="stretched-link"
                                       aria-label="View details for <%= result.department %> <%= result.course_num %>">
                                    </a>

                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <%- include("partials/bootstrap.ejs") %>
</body>
</html>