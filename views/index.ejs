<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights</title>
    <!-- loading Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <!-- load local stylesheet (css) -->
     <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <%- include("partials/flash.ejs") %>
    <%- include("partials/navbar.ejs") %>
    <div class="container">
        <div id="search-container">
            <form class="search" method="GET" action="/search/">
                <p>
                    <label>
                        Search:
                        <input type="text" name="term" placeholder="Search courses...">
                    </label>

                    <label for="tags">Tags: 
                        <select name="tag" id="tags" multiple size="1">
                            <option value="easyA">Easy A</option>
                            <option value="discussion">Discussion-based</option>
                            <option value="flipped">Flipped classroom</option>
                            <option value="300">300-level</option>
                            <option value="reading">Reading heavy</option>
                            <option value="tests">No tests</option>
                        </select>
                    </label>

                    <input type="submit" value="Search">
                </p>
            </form>
        </div>
        
        <div id="search-results-container" class="mt-5">
            <% if (results.length === 0) { %>
                <p class="text-center text-muted">No courses found matching your criteria.</p>
            <% } else { %>
                <div class="row">
                    <% results.forEach((result) => { %>
                        <div class="col-12 mb-3">
                            <div class="card course-card shadow-sm position-relative">
                                <div class="card-body">
                                    <h5 class="card-title mb-1">
                                        <%= result.department %> <%= result.course_num %>
                                    </h5>
                                    <h6 class="card-subtitle mb-2">
                                        <%= result.title %>
                                    </h6>
                                    <p class="card-text small mt-2 mb-0">
                                        <b>Instructor(s):</b> <%= result.instructors.join("; ") %>
                                    </p>
                                    
                                    <a href="/course/<%= result.department %>/<%= result.course_num %>" aria-label="View details for <%= result.department %> <%= result.course_num %>" class="stretched-link"></a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <%- include("partials/bootstrap.ejs") %>
</body>
</html>
