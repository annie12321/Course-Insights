<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Course Insights: Admin Panel</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.3.1/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
<%- include("partials/navbar.ejs") %>
<%- include("partials/flash.ejs") %>

<div class="container d-flex justify-content-center">
    <div class="card shadow-sm upload-card" style="width: 100%; max-width: 650px;">
        <div class="card-body">

            <h1 class="admin-title mb-2">Admin Panel</h1>

            <p class="text-muted mb-4">
                Manage user roles and permissions
            </p>

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% const superAdmins = ["annie", "foodlover"]; %>

                    <% users.forEach(u => { %>
                        <tr>
                            <td><%= u.username %></td>

                            <td>
                                <span class="badge badge-pill <%= u.role === 'admin' ? 'badge-success' : 'badge-secondary' %>">
                                    <%= u.role %>
                                </span>
                            </td>

                            <td>
                                <% if (!superAdmins.includes(u.username)) { %>
                                    <form method="POST" action="/admin/toggle/<%= u.username %>">
                                        <button class="btn btn-sm btn-warning">
                                            Toggle
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span class="text-muted small">Super Admin</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

        </div>
    </div>
</div>

<%- include("partials/bootstrap.ejs") %>
</body>
</html>